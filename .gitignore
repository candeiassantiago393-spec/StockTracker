# Python
.venv/
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/

# IDE / OS
.idea/
.vscode/*.log
*.swp
Thumbs.db
.DS_Store

# Credenciais e dados locais
config/secrets.py
.env

# Excel de trabalho (opcional — remover linha se quiseres versionar inventario)
data/stock.xlsx
~$*.xlsx

# Pastas por equipamento (datasheet + imagem)
data/equipments/*
!data/equipments/README.txt

# Cache de imagens de catalogo (so componentes visualizados; limitado)
data/component_image_cache/*
!data/component_image_cache/README.txt

# Backups automaticos do Excel
data/backups/*
!data/backups/README.txt

# Cache de URLs de catalogo (componentes visualizados)
data/catalog_links/*
!data/catalog_links/README.txt

# Relatorios temporarios
tools/_reorg_out.txt
tools/_tmp_*.png
src/gui/_reorganize_report.txt

# Settings and alert state (local runtime)
data/app_settings.json
data/calibration_alerts_sent.json

# Cursor / screenshots locais
assets/

# Desktop sync copies (local only)
Desktop/
LEIA-ME.txt
CORRER-*.bat

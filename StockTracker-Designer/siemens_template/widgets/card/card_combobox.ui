         <property name="styleSheet">
          <string notr="true">/* Base */
QComboBox{	
	padding: 5px;
	padding-left: 20px;
	padding-right: 20px;	
	min-width: 130;
	min-height: 18px;
	max-width: 130px;
	max-height: 18px;
	border-radius: 2px;
	border: 1px solid #B3B3BE;
	background-color: #00183B;
}

/* Mouser over Selector */
QComboBox:hover{
	background-color: #001F39;
	border: 1px solid #00FFB9;
}

/* Selection list colors */
QComboBox QAbstractItemView {
	background-color: #2D2D45;		/* background color */
	padding: 0px;
}

/*  Mouser over selection list   */
QComboBox QAbstractItemView::item:hover {
	padding: 0px;     
	padding-left: 10px;	
}
</string>
